---
import type { SiteSlotProps as Props } from "../types/site-files";
import { slotComponent } from "../lib/site-files";
import { slotCommonData } from "../lib/slot-data";

const { name, data = {}, class: className } = Astro.props;
const Component = slotComponent(name);
---

{
  Component ? (
    <div data-slot={name} class={className}>
      <Component {...slotCommonData()} {...data} />
    </div>
  ) : (
    <slot />
  )
}

---
import type { SiteAreasProps as Props } from "../types/navigation";
import { navbarAreas } from "../lib/navigation";

const sections = Astro.props.sections ?? await navbarAreas();
---

{
  sections.length > 0 && (
    <nav aria-label="Sections" class="flex min-w-0 items-center gap-0.5 overflow-x-auto text-sm">
      {sections.map((section) => (
        <a
          href={section.href}
          aria-current={section.active ? "page" : undefined}
          class:list={[
            "flex h-7.5 shrink-0 items-center whitespace-nowrap rounded-md px-2.5 transition-colors duration-150 ease-out",
            section.active ? "bg-foreground/[0.1] font-medium text-foreground dark:bg-foreground/[0.16]" : "text-muted-foreground hover:bg-foreground/[0.05] hover:text-foreground dark:hover:bg-foreground/[0.08]",
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )
}

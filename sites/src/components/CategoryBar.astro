---
import type { CategoryBarProps as Props } from "../types/categories";
import { href } from "../lib/params";
import Icon from "./Icon.astro";

const { categories, search = false, class: className } = Astro.props;
const options = categories.length > 0 ? [{ name: "All", slug: "" }, ...categories] : [];
---

<div data-category-bar class:list={["category-bar w-full max-w-(--layout-index)", className]}>
  <div class="flex flex-wrap items-center justify-end gap-4 md:flex-nowrap md:gap-6">
    {options.length > 0 && <div role="group" aria-label="Categories" class:list={["category-bar-scroll relative min-w-0 overflow-x-auto py-1", search ? "w-full md:w-auto md:flex-1" : "flex-1"]}>
      <div class="flex w-max items-center gap-1 px-1 md:gap-2">
        {
          options.map((option) => (
            <button
              type="button"
              data-category={option.slug}
              aria-pressed={option.slug === "" ? "true" : "false"}
              class="relative min-h-11 shrink-0 cursor-pointer px-3 py-2 text-sm/5 whitespace-nowrap text-foreground outline-offset-2 before:absolute before:inset-x-0 before:inset-y-1.5 before:-z-10 before:rounded-full hover:before:bg-muted aria-pressed:before:bg-muted isolate"
            >
              {option.name}
            </button>
          ))
        }
      </div>
    </div>}
    <div class:list={["flex items-center gap-3 md:shrink-0", search && "w-full md:w-auto"]}>
      {search && <form role="search" class="min-w-0 flex-1 md:w-52">
        <label class="relative block">
          <span class="sr-only">Search posts</span>
          <Icon name="search" size={16} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted-foreground" />
          <input data-blog-search type="search" name="q" placeholder="Search…" autocomplete="off" class="min-h-11 w-full rounded-full border border-border bg-transparent py-2 pr-4 pl-10 text-base text-foreground outline-offset-2 placeholder:text-muted-foreground md:text-sm" />
        </label>
      </form>}
      <a href={href("feed.xml")} aria-label="RSS feed" class="ml-auto flex size-11 shrink-0 items-center justify-center text-muted-foreground outline-offset-2 hover:text-foreground">
        <Icon name="rss" size={20} />
      </a>
    </div>
  </div>
  <p data-category-status role="status" class="sr-only" />
</div>

<style>
  .category-bar-scroll {
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent 0, black var(--fade-start, 0px), black calc(100% - var(--fade-end, 0px)), transparent 100%);
  }
  .category-bar-scroll::-webkit-scrollbar {
    display: none;
  }
  :global([data-category-list] > [data-last-shown]) {
    border-bottom-width: 0;
  }
</style>

<script>
  import { matchesBlogFilter } from "../utils/blog-filter";

  const PARAM = "category";
  for (const bar of document.querySelectorAll<HTMLElement>("[data-category-bar]")) {
    const scroller = bar.querySelector<HTMLElement>(".category-bar-scroll");
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-category]")];
    const list = document.querySelector<HTMLElement>("[data-category-list]");
    const empty = document.querySelector<HTMLElement>("[data-category-empty]");
    const search = bar.querySelector<HTMLInputElement>("[data-blog-search]");
    const featured = document.querySelector<HTMLElement>("[data-category-featured]");
    const status = bar.querySelector<HTMLElement>("[data-category-status]");
    const fade = () => {
      if (!scroller) {
        return;
      }
      const end = scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft;
      scroller.style.setProperty("--fade-start", `${Math.min(40, scroller.scrollLeft)}px`);
      scroller.style.setProperty("--fade-end", `${Math.min(40, Math.max(0, end))}px`);
    };
    const select = (slug: string, sync: boolean) => {
      const active = buttons.find((button) => button.dataset.category === slug) ?? buttons[0];
      const value = active?.dataset.category ?? "";
      const query = search?.value.trim() ?? "";
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button === active));
      }
      const unfiltered = !value && !query;
      const items = [...(list?.querySelectorAll<HTMLElement>("[data-categories]") ?? [])];
      for (const item of items) {
        item.hidden = (unfiltered && item.hasAttribute("data-pinned")) || !matchesBlogFilter(item.dataset.categories ?? "", item.dataset.search ?? "", value, query);
        item.removeAttribute("data-last-shown");
      }
      const visible = items.filter((item) => !item.hidden);
      visible.at(-1)?.setAttribute("data-last-shown", "");
      const shown = visible.length + (unfiltered ? (featured?.children.length ?? 0) : 0);
      if (featured) {
        featured.hidden = Boolean(query);
      }
      if (status) {
        status.textContent = `${shown} ${shown === 1 ? "post" : "posts"} found`;
      }
      if (empty) {
        empty.hidden = shown > 0;
        const label = empty.querySelector("[data-category-name]");
        if (label) {
          label.textContent = query ? "No posts match your search." : "No posts in this category yet.";
        }
      }
      if (sync) {
        const url = new URL(location.href);
        if (value) {
          url.searchParams.set(PARAM, value);
        } else {
          url.searchParams.delete(PARAM);
        }
        if (query) {
          url.searchParams.set("q", query);
        } else {
          url.searchParams.delete("q");
        }
        history.replaceState(history.state, "", url);
      }
    };
    bar.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-category]");
      if (button) {
        select(button.dataset.category ?? "", true);
        button.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    });
    search?.addEventListener("input", () => select(bar.querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.category ?? "", true));
    search?.form?.addEventListener("submit", (event) => event.preventDefault());
    scroller?.addEventListener("scroll", fade, { passive: true });
    addEventListener("resize", fade);
    fade();
    const initial = new URLSearchParams(location.search).get(PARAM);
    if (search) {
      search.value = new URLSearchParams(location.search).get("q") ?? "";
    }
    if (initial || search?.value) {
      select(initial ?? "", false);
      if (scroller) {
        const active = bar.querySelector<HTMLElement>('[aria-pressed="true"]');
        scroller.scrollLeft = active ? active.offsetLeft - (scroller.clientWidth - active.offsetWidth) / 2 : 0;
        fade();
      }
    }
  }
</script>

---
import { navbarAreas, navbarCta, navbarLinks, navbarPrimary } from "../lib/navigation";
import { config, href } from "../lib/params";
import { logoFor } from "../lib/theme";
import Icon from "./Icon.astro";
import LinkIcon from "./LinkIcon.astro";
import SiteAreas from "./SiteAreas.astro";
import NavbarItem from "./NavbarItem.astro";

const lightLogo = logoFor("light");
const darkLogo = logoFor("dark");
const hasDarkLogo = Boolean(darkLogo && darkLogo !== lightLogo);
const logoHref = typeof config.logo === "object" && config.logo.href ? config.logo.href : href();
const sections = await navbarAreas();
const hasSections = sections.length > 0;
const links = navbarLinks();
const cta = navbarCta();
const primary = navbarPrimary();
const hasMenu = links.length > 0 || Boolean(cta) || Boolean(primary);
---

<header
  id="navbar"
  data-site-header
  class="sticky top-0 z-30 bg-[color-mix(in_oklab,var(--page-background)_88%,transparent)] backdrop-blur-lg"
>
  <div class="site-container flex h-14 items-center gap-3">
    <a href={logoHref} class="flex min-w-0 items-center gap-2 rounded-md text-[0.9375rem] font-semibold tracking-[-0.01em]">
      {
        lightLogo && hasDarkLogo && (
          <>
            <img src={lightLogo} alt="" width="24" height="24" class="size-6 shrink-0 rounded-md object-contain dark:hidden" />
            <img src={darkLogo} alt="" width="24" height="24" class="hidden size-6 shrink-0 rounded-md object-contain dark:block" />
          </>
        )
      }
      {
        lightLogo && !hasDarkLogo && (
          <img src={lightLogo} alt="" width="24" height="24" class="size-6 shrink-0 rounded-md object-contain dark:box-content dark:bg-white dark:p-1" />
        )
      }
      <span class="truncate" title={config.name}>{config.name}</span>
    </a>

    {
      hasSections && (
        <>
          <span aria-hidden="true" class="h-4 w-px shrink-0 bg-border" />
          <div class="-ml-1 min-w-0">
            <SiteAreas sections={sections} />
          </div>
        </>
      )
    }

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {
        links.length > 0 && (
          <nav aria-label="Main" class="mr-2 hidden items-center gap-5 text-sm md:flex">
            {links.map((item) => <NavbarItem item={item} />)}
          </nav>
        )
      }
      {
        primary && (
          <div id="topbar-primary-button" class="ml-2 hidden md:flex">
            <a href={primary.href} class="btn btn-secondary btn-sm">
              <LinkIcon icon={primary.icon} size={14} />
              {primary.label}
            </a>
          </div>
        )
      }
      {
        cta && (
          <div id="topbar-cta-button" class="ml-2 hidden md:flex">
            <a href={cta.href} class="btn btn-primary btn-sm">
              {cta.label}
            </a>
          </div>
        )
      }
      {
        hasMenu && (
          <button type="button" popovertarget="mobile-nav" aria-label="Menu" class="btn btn-ghost btn-icon md:hidden">
            <Icon name="menu" size={16} class="site-menu-open" />
            <Icon name="close" size={16} class="site-menu-close" />
          </button>
        )
      }
    </div>
  </div>

  {
    hasMenu && (
      <div id="mobile-nav" popover class="site-menu md:hidden">
        <nav id="mobile-nav-content" aria-label="Main" class="site-container flex flex-col py-2">
          {links.map((item) => <NavbarItem item={item} mobile />)}
        </nav>
        {
          (cta || primary) && (
            <div class="site-container flex flex-col gap-2 pt-1 pb-4">
              {primary && (
                <a href={primary.href} class="btn btn-secondary w-full justify-center">
                  <LinkIcon icon={primary.icon} size={14} />
                  {primary.label}
                </a>
              )}
              {cta && (
                <a href={cta.href} class="btn btn-primary w-full justify-center">
                  {cta.label}
                </a>
              )}
            </div>
          )
        }
      </div>
    )
  }
</header>

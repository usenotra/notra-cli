---
import Base from "../layouts/Base.astro";
import { areaTitle, config, href, params } from "../lib/params";
import { renderInlineMarkdown } from "../utils/inline-markdown";

const notFound = config.errors[404];
const title = notFound.title ?? "This page doesn't exist";
const description = renderInlineMarkdown(notFound.description ?? "It may have moved, or the link is wrong.");
const target = href();
---

<Base page="not-found" title={`${notFound.title ?? "Page not found"} · ${config.name}`} noindex>
  {
    notFound.redirect && (
      <Fragment slot="head">
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <script is:inline define:vars={{ target }}>
          location.replace(target);
        </script>
      </Fragment>
    )
  }
  <section class="mx-auto flex min-h-[55svh] max-w-md flex-col items-center justify-center py-16 text-center">
    <p class="font-mono text-sm text-muted-foreground tabular-nums">404</p>
    <h1 id="page-title" class="mt-3 font-heading text-2xl font-(--font-heading-weight) tracking-[-0.025em] text-balance sm:text-3xl">{title}</h1>
    <p class="mt-3 text-pretty text-muted-foreground [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4" set:html={description} />
    <a href={target} class="btn btn-primary mt-8">Back to {areaTitle(params.area)}</a>
  </section>
</Base>

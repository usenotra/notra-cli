---
import type { AuthorPageProps as Props, ListedAuthor } from "../../types/authors";
import AuthorAvatar from "../../components/AuthorAvatar.astro";
import AuthorSocials from "../../components/AuthorSocials.astro";
import PostCard from "../../components/PostCard.astro";
import SiteSlot from "../../components/SiteSlot.astro";
import Base from "../../layouts/Base.astro";
import { allAuthors, authoredBy, personNode } from "../../lib/authors";
import { POST_CARD_CELL } from "../../constants/post-card";
import { cardImages } from "../../lib/cards";
import { getBlogEntries } from "../../lib/entries";
import { blogOptions } from "../../lib/options";
import { absoluteUrl, config, href, params } from "../../lib/params";
import { breadcrumbs, pageTitle } from "../../lib/seo";
import { slotAuthor } from "../../lib/slot-data";

export async function getStaticPaths() {
  if (params.area !== "blog") {
    return [];
  }
  const entries = await getBlogEntries();
  return allAuthors(entries)
    .filter((author): author is ListedAuthor => author.id !== null && entries.some((entry) => authoredBy(entry, author.id)))
    .map((author) => ({ params: { author: author.id }, props: { author } }));
}

const { author } = Astro.props;
const posts = (await getBlogEntries()).filter((entry) => authoredBy(entry, author.id));
const images = cardImages(posts);
const url = absoluteUrl(author.href ?? href());
const description = author.bio ?? `Posts by ${author.name}.`;
const noindex = config.seo.indexing !== "all";
const stacked = blogOptions.authorPage === "stacked";
const boxed = blogOptions.layout === "cards";
const [onlyPost] = posts.length === 1 ? posts : [];
const postCount = `${posts.length} ${posts.length === 1 ? "post" : "posts"}`;
const slotData = { author: slotAuthor(author, posts.length) };
const jsonLd = [
  { "@type": "ProfilePage", "@id": `${url}#page`, url, name: author.name, mainEntity: { ...personNode(author), "@id": `${url}#person` } },
  breadcrumbs(author.name, url),
];
---

<Base page="author" title={pageTitle(author.name)} description={description} jsonLd={jsonLd} noindex={noindex}>
  {
    stacked ? (
      <div class="author-stacked mx-auto w-full max-w-(--layout-index)">
        <SiteSlot name="author-hero" data={slotData}>
          <header class="author-profile flex flex-col items-start gap-5">
            <AuthorAvatar author={author} size={80} loading="eager" />
            <div class="flex flex-col gap-1">
              <h1 id="page-title" class="font-heading text-4xl font-medium tracking-[-0.02em]">{author.name}</h1>
              {author.title && <p class="author-title font-mono text-sm text-muted-foreground">{author.title}</p>}
            </div>
            {author.bio && <p class="author-bio max-w-xl text-lg leading-8 text-pretty text-muted-foreground">{author.bio}</p>}
            <AuthorSocials socials={author.socials} />
          </header>
        </SiteSlot>
        <div class="mt-14 border-t border-border pt-8">
          <h2 class="author-post-count font-mono text-sm text-muted-foreground">{postCount}</h2>
          <ul class:list={["mt-6 grid grid-cols-1 sm:grid-cols-2", boxed ? "gap-6" : "-mb-12 gap-x-8 lg:grid-cols-3"]}>
            {posts.map((entry) => (
              <li class:list={[boxed ? "h-full" : ["pb-12", POST_CARD_CELL]]}>
                <PostCard entry={entry} images={images} variant={boxed ? "box" : "card"} headingLevel="h3" showAuthor={boxed} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <div class="mx-auto w-full max-w-(--layout-index) pt-4 sm:pt-8 lg:pt-10">
        <SiteSlot name="author-hero" data={slotData}>
          <header class="author-profile flex flex-col items-start">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-6">
              <AuthorAvatar author={author} size={80} loading="eager" />
              <div class="flex min-w-0 flex-col gap-1">
                <h1 id="page-title" class="font-heading text-3xl leading-tight font-(--font-heading-weight) tracking-[-0.03em] text-balance sm:text-4xl">{author.name}</h1>
                {author.title && <p class="author-title text-base text-muted-foreground">{author.title}</p>}
              </div>
            </div>
            {author.bio && <p class="author-bio mt-6 max-w-xl text-lg leading-8 text-pretty text-muted-foreground">{author.bio}</p>}
            <AuthorSocials socials={author.socials} class="mt-6" />
          </header>
        </SiteSlot>
        <section aria-labelledby="author-posts" class="mt-12 border-t border-border pt-8 sm:mt-14">
          <h2 id="author-posts" class="author-post-count text-sm text-muted-foreground tabular-nums">{postCount}</h2>
          {boxed ? (
            <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
              {posts.map((entry) => (
                <li class:list={["h-full", onlyPost && "sm:col-span-2"]}>
                  <PostCard entry={entry} images={images} variant="box" headingLevel="h3" showAuthor={false} />
                </li>
              ))}
            </ul>
          ) : blogOptions.layout === "list" ? (
            <ul class="mt-2 divide-y divide-border">
              {posts.map((entry) => (
                <li>
                  <PostCard entry={entry} images={images} variant="row" headingLevel="h3" showAuthor={false} />
                </li>
              ))}
            </ul>
          ) : onlyPost ? (
            <div class="mt-6">
              <PostCard entry={onlyPost} images={images} variant="feature" headingLevel="h3" showAuthor={false} priority />
            </div>
          ) : (
            <ul class="mt-6 grid grid-cols-1 gap-x-8 max-sm:divide-y max-sm:divide-border sm:-mb-12 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((entry) => (
                <li class:list={["max-sm:py-6 max-sm:first:pt-0 sm:pb-12", POST_CARD_CELL]}>
                  <PostCard entry={entry} images={images} headingLevel="h3" showAuthor={false} />
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    )
  }
</Base>

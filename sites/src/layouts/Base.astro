---
import type { BaseLayoutProps as Props } from "../types/seo";
import type { SitePageContext } from "../types/site-files";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "@notra/custom-css";
import Consent from "@notra/consent";
import Banner from "../components/Banner.astro";
import CodeBlocks from "../components/CodeBlocks.astro";
import CustomChrome from "../components/CustomChrome.astro";
import DevReload from "../components/DevReload.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SiteSlot from "../components/SiteSlot.astro";
import { siteBanner } from "../lib/banner";
import { absoluteUrl, areaTitle, config, llmsHref, namedAreaTitle, params } from "../lib/params";
import { extraMetaTags, socialImage, structuredData, themeColors, touchIcon, twitterHandle } from "../lib/seo";
import { listedAreas } from "../lib/entries";
import { chromeComponent } from "../lib/site-files";
import { decorationClass, faviconFor, fontFaces, fontStylesheetUrl, themeStyle } from "../lib/theme";
import { mountPath } from "../utils/paths";

const { page, title, description, image, imageAlt, generatedImage, type = "website", noindex = false, publishedTime, modifiedTime, tags = [], markdown, jsonLd } = Astro.props;
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : Astro.url.pathname;
const canonical = absoluteUrl(canonicalPath);
const ogImage = socialImage(image, generatedImage, imageAlt);
const robots = params.noindex || noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const twitterSite = twitterHandle();
const colors = themeColors();
const appleTouchIcon = touchIcon();
const feeds = (await listedAreas({ keepCurrent: false })).flatMap((area) => {
  const mount = params.mounts[area];
  return mount ? [{ title: namedAreaTitle(area), href: mountPath(mount, "feed.xml") }] : [];
});
const fontsUrl = fontStylesheetUrl();
const preloadInter = !(config.fonts?.body?.family ?? config.fonts?.family);
const appearance = config.appearance;
const codeDark = config.styling.codeblocks === "dark";
const lightFavicon = faviconFor("light");
const darkFavicon = faviconFor("dark");
const metaTags = extraMetaTags();
const customTags = new Set(metaTags.map((tag) => tag.value.toLowerCase()));
const builtIn = (name: string) => !customTags.has(name);
const customRobots = !params.noindex && !noindex && !builtIn("robots");
const customImage = !builtIn("og:image");
const twitterCard = customImage || ogImage?.large ? "summary_large_image" : "summary";
const banner = siteBanner();
const dismissKey = banner?.dismissible ? banner.storageKey : null;
const customHeader = Boolean(chromeComponent("header"));
const customFooter = Boolean(chromeComponent("footer"));
const pageContext: SitePageContext = { page, area: params.area, path: canonicalPath };
---

<!doctype html>
<html lang="en" class:list={[decorationClass(), codeDark && "code-dark"]}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.DEV && process.env.NOTRA_DEV_DOCUMENT_TOKEN && <DevReload />}
    {builtIn("viewport") && <meta name="viewport" content="width=device-width, initial-scale=1" />}
    <title>{title}</title>
    {description && builtIn("description") && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {!customRobots && <meta name="robots" content={robots} />}
    {lightFavicon && <link rel="icon" href={lightFavicon} media={darkFavicon !== lightFavicon ? "(prefers-color-scheme: light)" : undefined} />}
    {darkFavicon && darkFavicon !== lightFavicon && <link rel="icon" href={darkFavicon} media="(prefers-color-scheme: dark)" />}
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    {builtIn("theme-color") && <meta name="theme-color" content={colors.light} media="(prefers-color-scheme: light)" />}
    {builtIn("theme-color") && <meta name="theme-color" content={colors.dark} media="(prefers-color-scheme: dark)" />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href={llmsHref()} />
    {feeds.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />)}
    {builtIn("og:type") && <meta property="og:type" content={type} />}
    {builtIn("og:title") && <meta property="og:title" content={title} />}
    {builtIn("og:url") && <meta property="og:url" content={canonical} />}
    {builtIn("og:site_name") && <meta property="og:site_name" content={config.name} />}
    {description && builtIn("og:description") && <meta property="og:description" content={description} />}
    {builtIn("og:locale") && <meta property="og:locale" content="en_US" />}
    {ogImage && builtIn("og:image") && <meta property="og:image" content={ogImage.url} />}
    {ogImage && !customImage && builtIn("og:image:alt") && <meta property="og:image:alt" content={ogImage.alt ?? (ogImage.large ? title : config.name)} />}
    {publishedTime && builtIn("article:published_time") && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === "article" && modifiedTime && builtIn("article:modified_time") && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && builtIn("article:section") && <meta property="article:section" content={areaTitle(params.area)} />}
    {type === "article" && builtIn("article:tag") && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {builtIn("twitter:card") && <meta name="twitter:card" content={twitterCard} />}
    {ogImage?.alt && !customImage && builtIn("twitter:image:alt") && <meta name="twitter:image:alt" content={ogImage.alt} />}
    {twitterSite && builtIn("twitter:site") && <meta name="twitter:site" content={twitterSite} />}
    {builtIn("generator") && <meta name="generator" content="Notra Sites" />}
    {metaTags.filter((tag) => tag.value.toLowerCase() !== "robots" || customRobots).map((tag) => (tag.key === "property" ? <meta property={tag.value} content={tag.content} /> : <meta name={tag.value} content={tag.content} />))}
    {jsonLd && <script type="application/ld+json" set:html={structuredData(jsonLd)} />}
    {preloadInter && <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />}
    {fontsUrl && <link rel="stylesheet" href={fontsUrl} />}
    <style is:inline set:html={`${fontFaces()}${themeStyle()}`}></style>
    <script is:inline define:vars={{ appearance }}>
      const stored = appearance.strict ? null : localStorage.getItem(appearance.storageKey);
      const mode = stored === "light" || stored === "dark" || stored === "system" ? stored : appearance.default;
      const dark = mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("c15t-dark", dark);
      document.documentElement.dataset.themeMode = mode;
      document.documentElement.dataset.themeStorageKey = appearance.storageKey;
    </script>
    {
      dismissKey && (
        <script is:inline define:vars={{ dismissKey }}>
          if (localStorage.getItem(dismissKey)) {
            document.documentElement.setAttribute("data-banner-dismissed", "");
          }
        </script>
      )
    }
    <slot name="head" />
    <Consent part="head" />
    {
      params.headScripts.map((script) =>
        script.kind === "external" ? <script is:inline src={script.src} {...script.attributes} /> : <script is:inline set:html={script.code} />
      )
    }
  </head>
  <body id="body-content" class="flex min-h-dvh flex-col font-sans text-foreground">
    <a href="#content-area" class="skip-link">Skip to content</a>
    {banner && <Banner banner={banner} />}
    {customHeader ? <CustomChrome part="header" context={pageContext} /> : <Header />}
    <main id="content-area" tabindex="-1" class="w-full flex-1 px-4 pt-4 pb-24 outline-none sm:px-6 sm:pt-6">
      <div id="content"><slot /></div>
      <SiteSlot name="before-footer" data={pageContext} class="mt-16 empty:hidden" />
    </main>
    {customFooter ? <CustomChrome part="footer" context={pageContext} /> : <Footer />}
    <CodeBlocks />
    <Consent part="body" />
  </body>
</html>

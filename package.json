{
  "name": "notra",
  "version": "0.2.0",
  "description": "Command-line interface for the Notra API and local Notra Sites previews.",
  "type": "module",
  "license": "MIT AND AGPL-3.0-only",
  "homepage": "https://www.usenotra.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/notra-cli.git"
  },
  "bugs": {
    "url": "https://github.com/usenotra/notra-cli/issues"
  },
  "keywords": [
    "notra",
    "cli",
    "changelog",
    "content"
  ],
  "bin": {
    "notra": "./dist/run.js"
  },
  "files": [
    "dist",
    "sites"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun ./src/run.ts",
    "start": "bun ./dist/run.js",
    "build": "bun ./scripts/build.ts",
    "openapi:sync": "bun ./scripts/sync-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@c15t/astro": "3.0.0",
    "@c15t/dev-tools": "3.0.0",
    "@c15t/integrations": "3.0.0",
    "@c15t/react": "3.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@inquirer/prompts": "^7.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "acorn": "8.18.0",
    "acorn-jsx": "5.3.2",
    "astro": "7.3.5",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "conf": "^13.1.0",
    "estree-util-visit": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-mdast": "10.1.2",
    "ignore": "7.0.12",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "ora": "^8.1.1",
    "parse5-sax-parser": "8.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "^0.26.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.7.2"
  }
}

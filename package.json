{
  "name": "notra",
  "version": "0.1.0",
  "description": "Command-line interface for the Notra API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.usenotra.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/notra-cli.git"
  },
  "bugs": {
    "url": "https://github.com/usenotra/notra-cli/issues"
  },
  "keywords": [
    "notra",
    "cli",
    "changelog",
    "content"
  ],
  "bin": {
    "notra": "./dist/run.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun ./src/run.ts",
    "start": "bun ./dist/run.js",
    "build": "bun ./scripts/build.ts",
    "openapi:sync": "bun ./scripts/sync-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "conf": "^13.1.0",
    "ora": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
